<Window
    x:Class="Contacts.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:View.Converters"
    Title="Contacts"
    Width="613"
    Height="400">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!--  Левая колонка  -->
        <Grid Grid.Column="0" Background="#f8f8f8">
            <Border Padding="8" Background="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--  Поле поиска  -->
                    <Grid Grid.Row="0" Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Find:"/>
                        <TextBox
                            Grid.Column="1"
                            Height="20"
                            MinWidth="50"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsReadOnly="True"/>
                    </Grid>

                    <!--  Таблица контактов  -->
                    <ListBox
                        x:Name="ContactsList"
                        Grid.Row="1"
                        Margin="3"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Contacts}"
                        SelectedItem="{Binding SelectedContact, Mode=TwoWay}"/>
                    <!--  Кнопки управления  -->
                    <Grid Grid.Row="2" Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="25"
                            Margin="3"
                            Command="{Binding AddCommand}"
                            Content="Add"/>
                        <Button
                            Grid.Column="1"
                            Height="25"
                            Margin="3"
                            Command="{Binding EditCommand}"
                            Content="Edit"/>
                        <Button
                            Grid.Column="2"
                            Height="25"
                            Margin="3"
                            Command="{Binding RemoveCommand}"
                            Content="Remove"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Разделитель колонок  -->
        <GridSplitter
            Grid.Column="1"
            Width="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="White"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"/>

        <!--  Правая колонка  -->
        <Grid Grid.Column="2" Background="White">
            <Border Margin="8" Background="{x:Null}">
                <Grid>
                    <Grid.BindingGroup>
                        <BindingGroup x:Name="ContactBindingGroup"/>
                    </Grid.BindingGroup>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--  Фото контакта  -->
                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Width="100"
                        Height="100"
                        Margin="1 23 7 29"
                        Source="/Resources/photo_placeholder_100x100.png"/>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="3"
                        Orientation="Vertical">
                        <TextBlock Text="Name:"/>
                        <TextBox
                            Margin="0 3 0 0"
                            IsReadOnly="{Binding IsReadOnlyMode}"
                            Text="{Binding SelectedContact.Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="3"
                        Orientation="Vertical">
                        <TextBlock Text="Phone Number:"/>
                        <TextBox
                            Margin="0 3 0 0"
                            IsReadOnly="{Binding IsReadOnlyMode}"
                            Text="{Binding SelectedContact.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="3"
                        Orientation="Vertical">
                        <TextBlock Text="Email:"/>
                        <TextBox
                            Margin="0 3 0 0"
                            IsReadOnly="{Binding IsReadOnlyMode}"
                            Text="{Binding SelectedContact.Email, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                    </StackPanel>

                    <!--  Кнопка "Apply"  -->
                    <Button
                        Grid.Row="4"
                        Grid.Column="1"
                        Width="75"
                        Height="25"
                        Margin="0 50 0 0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsAddOrEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding ApplyCommand}"
                        CommandParameter="{Binding ElementName=ContactBindingGroup}"
                        Content="Apply"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>