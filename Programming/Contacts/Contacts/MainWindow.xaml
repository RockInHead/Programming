<Window
    x:Class="Contacts.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:View.Controls"
    xmlns:local="clr-namespace:View.Converters"
    Title="Contacts"
    Width="613"
    Height="400"
    MinWidth="550"
    MinHeight="300"
    Icon="Resources/contacts_96x96.ico">

    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!--  DataTemplate для списка контактов  -->
        <DataTemplate x:Key="ContactTemplate">
            <StackPanel
                Margin="3"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  Фото контакта  -->
                <Ellipse
                    Width="30"
                    Height="30"
                    Margin="0 0 8 0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Resources/photo_placeholder_100x100.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <!--  Данные контакта  -->
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"/>
                    <TextBlock FontSize="10" Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!--  Левая колонка  -->
        <Grid Grid.Column="0" Background="#f8f8f8">
            <Border Padding="8" Background="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--  Поле поиска  -->
                    <Grid Grid.Row="0" Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Find:"/>
                        <TextBox
                            Grid.Column="1"
                            Height="20"
                            MinWidth="50"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsReadOnly="True"/>
                    </Grid>

                    <!--  Таблица контактов  -->
                    <ListBox
                        x:Name="ContactsList"
                        Grid.Row="1"
                        Margin="3"
                        ItemTemplate="{StaticResource ContactTemplate}"
                        ItemsSource="{Binding Contacts}"
                        SelectedItem="{Binding SelectedContact, Mode=TwoWay}"/>
                    <!--  Кнопки управления  -->
                    <Grid Grid.Row="2" Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="25"
                            Margin="3"
                            Command="{Binding AddCommand}"
                            Content="Add"/>
                        <Button
                            Grid.Column="1"
                            Height="25"
                            Margin="3"
                            Command="{Binding EditCommand}"
                            Content="Edit"/>
                        <Button
                            Grid.Column="2"
                            Height="25"
                            Margin="3"
                            Command="{Binding RemoveCommand}"
                            Content="Remove"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Разделитель колонок  -->
        <GridSplitter
            Grid.Column="1"
            Width="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="White"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns"/>

        <!--  Правая колонка  -->
        <controls:ContactControl
            Grid.Column="2"
            Margin="5"
            DataContext="{Binding SelectedContact}"/>
    </Grid>
</Window>