<UserControl
    x:Class="View.Controls.ContactControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:View.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Border Margin="8" Background="{x:Null}">
            <Grid>
                <Grid.BindingGroup>
                    <BindingGroup x:Name="ContactBindingGroup"/>
                </Grid.BindingGroup>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--  Фото контакта  -->
                <Image
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Width="100"
                    Height="100"
                    Margin="1 23 7 29"
                    Source="/Resources/photo_placeholder_100x100.png"/>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="3"
                    Orientation="Vertical">
                    <TextBlock Text="Name:"/>
                    <TextBox
                        Margin="0 3 0 0"
                        IsReadOnly="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="3"
                    Orientation="Vertical">
                    <TextBlock Text="Phone Number:"/>
                    <TextBox
                        Margin="0 3 0 0"
                        IsReadOnly="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}"
                        Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="3"
                    Orientation="Vertical">
                    <TextBlock Text="Email:"/>
                    <TextBox
                        Margin="0 3 0 0"
                        IsReadOnly="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}"
                        Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                </StackPanel>

                <!--  Кнопка "Apply"  -->
                <Button
                    Grid.Row="4"
                    Grid.Column="1"
                    Width="75"
                    Height="25"
                    Margin="0 50 0 0"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding ElementName=ContactBindingGroup}"
                    Content="Apply"
                    Visibility="{Binding DataContext.IsAddOrEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
